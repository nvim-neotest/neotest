#!/bin/bash
# Run the unit suite with mini.test.
#
# mini.test executes all collected cases inside a single Neovim process. To
# preserve the per-file isolation the old plenary harness provided (it ran
# every spec file in its own headless Neovim child), this script spawns one
# headless Neovim per spec file and aggregates the exit codes.
#
# Exit code: mini.test's stdout reporter cquits with 1 when any case fails.
#
# Usage:
#   scripts/test              # all specs under tests/unit
#   scripts/test <file>       # a single spec file

status=0
files=()

if [[ -n $1 ]]; then
	files=("$1")
else
	while IFS= read -r -d '' f; do
		files+=("$f")
	done < <(find tests/unit -name '*_spec.lua' -print0 | sort -z)
fi

for f in "${files[@]}"; do
	nvim --headless --noplugin -u tests/minimal_init.lua \
		-c "lua MiniTest.run({ collect = { find_files = function() return { '$f' } end } })" || status=1
done

exit $status
